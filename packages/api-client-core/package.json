{
  "name": "@worldvs/api-client-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsx -e \"import{execSync}from'child_process';execSync('tsc -p tsconfig.json',{stdio:'inherit'})\"",
    "typecheck": "tsx -e \"import{execSync}from'child_process';execSync('tsc --noEmit -p tsconfig.json',{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
